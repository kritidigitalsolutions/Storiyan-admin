            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@gmail.com\",\n  \"preferredLanguage\": \"Hindi\",\n  \"profileImage\": \"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120&auto=format&fit=crop&q=80\"\n}"
