  "item": [
    {
      "name": "1. Authentication & Profile",
      "item": [
        {
          "name": "1.1 Send OTP (Phone Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"language\": \"Hindi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "send-otp"]
            },
            "description": "Initiates phone-based OTP login for Flutter app. Returns generated 6-digit OTP for testing without external SMS gateway."
          }
        },
        {
          "name": "1.2 Verify OTP & Login / Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"userToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.token);",
                  "    console.log(\"Saved userToken:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["user", "auth", "verify-otp"]
            },
            "description": "Verifies 6-digit OTP, creates or retrieves user account, and returns JWT session token."
          }
        },
        {
          "name": "1.3 Get Current User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            },
            "description": "Fetches current logged-in user profile with coin balance, active subscription pass, unlocked episodes, and preferences."
          }
        },
        {
          "name": "1.4 Update User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
